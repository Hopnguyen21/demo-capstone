# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment variables & secrets
.env
.env*.local
*.env
*.pem
*.key
*.pfx
*.cert

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, IntelliJ, WebStorm, Android Studio)
.idea/
*.iws
*.iml

# ------------------------------------------------------------------------------
# .NET / C# (Backend)
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
[Tt]est[Rr]esults/
*.xap
*.apk
*.aab

